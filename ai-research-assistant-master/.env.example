# Environment Variables — copy this to .env and fill in your values

# ====================
# LLM Configuration
# ====================
# write mistral for mistral or gemini for Gemini, or auto to let the app decide based on availability
LLM_PROVIDER=auto
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# ====================
# App Configuration
# ====================
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ====================
# ChromaDB
# ====================
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=research_documents

# ====================
# Chunking Settings
# ====================
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_RETRIEVED_CHUNKS=6

# ====================
# Embeddings
# ====================
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ====================
# Upload Settings
# ====================
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,txt

# ====================
# Auth
# ====================
AUTH_DB_PATH=./data/auth.db
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=1440
